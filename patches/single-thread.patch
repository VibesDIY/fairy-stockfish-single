@@ -27,7 +27,24 @@
 /// The implementation calls pthread_create() with the stack size parameter
 /// equal to the linux 8MB default, on platforms that support it.
 
-#if defined(__APPLE__) || defined(__MINGW32__) || defined(__MINGW64__) || defined(USE_PTHREADS)
+#if defined(SINGLE_THREAD)
+
+namespace Stockfish {
+
+/// SINGLE_THREAD (the browser WebAssembly build without SharedArrayBuffer):
+/// no OS thread is ever started. Thread::start_searching() runs the search
+/// on the caller's stack instead, so this class only has to exist.
+class NativeThread {
+public:
+  NativeThread() = default;
+  template<class T> NativeThread(void(T::*)(), T*) {}
+  void join() {}
+  void detach() {}
+};
+
+} // namespace Stockfish
+
+#elif defined(__APPLE__) || defined(__MINGW32__) || defined(__MINGW64__) || defined(USE_PTHREADS)
 
 #include <pthread.h>
 
