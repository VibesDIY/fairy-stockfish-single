+#include <emscripten/emscripten.h>
+
+/// fsf_command() is the WebAssembly build's whole input: the page (or the
+/// worker glue in fairy-stockfish-single) calls it once per UCI line, and the
+/// engine answers on stdout, which Emscripten routes to Module.print.
+extern "C" EMSCRIPTEN_KEEPALIVE void fsf_command(const char* line) {
+  std::string cmd(line);
+  char name[] = "fairy-stockfish";
+  char* argv[] = { name, cmd.data(), nullptr };
+  UCI::loop(2, argv);
+}
+#endif
